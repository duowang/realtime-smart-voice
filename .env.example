# Environment Variables for Realtime Smart Voice Assistant
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required for Realtime API)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Picovoice Access Key (required for wake word detection)
# Get free key from: https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=your_porcupine_access_key_here

# Set runtime timeouts in config/config.json:
# conversation_timeout, silence_timeout, post_response_timeout
