# ./run.sh --setup-only creates .env from this template if a key is missing.
# Edit .env, not this example. Keep your key private; .env is ignored by Git.

# OpenAI API key (required for spoken conversations and commands)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Wake-word detection runs locally; no additional API key is needed.

# Set runtime timeouts in config/config.json:
# conversation_timeout, silence_timeout, post_response_timeout
